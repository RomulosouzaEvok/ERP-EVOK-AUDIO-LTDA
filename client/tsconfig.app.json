{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // Testes ficam fora do build de app: os de guarda (departments.seeds,
  // AppLayout.navigation) usam `node:fs`/`node:path`, que não existem no
  // ambiente do bundle — com eles incluídos, `npm run build` quebrava
  // (TS2591) desde fdb544c. O Vitest compila os testes pelo próprio pipeline.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test"]
}
