# =============================================================================
# ERP EVOK AUDIO - Configuracao de Ambiente
# =============================================================================
# Modelo raiz alinhado ao backend PostgreSQL atual.
# Troque todos os placeholders antes de qualquer uso real.
# =============================================================================

# --- Servidor ---
NODE_ENV=development
PORT=5000

# --- Banco de Dados PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_evok_audio
DB_USER=evok_admin
DB_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
DB_SSL=false
DB_SSL_CA_PATH=
DB_SSL_CA_BASE64=
DB_LOGGING=false
DB_FORCE_SYNC=false
DB_AUTO_ALTER=false
DB_ALLOW_UNSAFE_ALTER=false

# --- JWT ---
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
JWT_EXPIRE=7d

# --- Sistema ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Numero de saltos de proxy reverso confiaveis na frente da API (nginx,
# load balancer). 0 = sem proxy (dev local). Em producao atras de 1 proxy,
# usar 1 — necessario para o rate-limit de login usar o IP real do
# cliente, nao o IP do proxy.
TRUST_PROXY=0

# --- Seed administrativo ---
ADMIN_SEED_PASSWORD=CHANGE_ME_REQUIRED_IN_PRODUCTION

# --- Upload ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# --- QR Code ---
QR_CODE_URL=http://localhost:5000

# --- Email (opcional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@evokaudio.com.br

# --- Webhook de entrada do n8n (obrigatorio para /api/webhooks/n8n) ---
N8N_WEBHOOK_SECRET=CHANGE_ME_generate_a_random_32_byte_secret

