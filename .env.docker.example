NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_evok_audio
DB_USER=evok_admin
DB_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
DB_SSL=false
# Flag lida por server/src/config/runtimeEnv.ts: permite NODE_ENV=production
# subir com DB_SSL=false. Usar apenas em dev local com Postgres sem SSL.
# NUNCA definir ALLOW_LOCAL_DB_NO_SSL=true em producao real.
ALLOW_LOCAL_DB_NO_SSL=false
DB_LOGGING=false

JWT_SECRET=troque-por-uma-chave-forte
CORS_ORIGIN=http://localhost:5173
ADMIN_SEED_PASSWORD=CHANGE_ME_REQUIRED_IN_PRODUCTION

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
