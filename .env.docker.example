NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_evok_audio
DB_USER=evok_admin
DB_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
DB_SSL=false
# Flag lida por server/src/config/runtimeEnv.ts: permite NODE_ENV=production
# subir com DB_SSL=false. Usar apenas em dev local com Postgres sem SSL.
# NUNCA definir ALLOW_LOCAL_DB_NO_SSL=true em producao real.
ALLOW_LOCAL_DB_NO_SSL=false
DB_LOGGING=false

# OBRIGATORIO. Gere um valor unico POR INSTALACAO — nunca reaproveite o exemplo:
#   openssl rand -hex 32
#   node -e "console.log(require(0+`crypto`).randomBytes(32).toString(`hex`))"
# O valor abaixo e placeholder DE PROPOSITO: o boot REPROVA enquanto nao for
# trocado (runtimeEnv.ts, guarda ativa em TODOS os ambientes). Um exemplo com
# segredo valido faria todas as instalacoes compartilharem a mesma chave.
JWT_SECRET=CHANGE_ME_gere_um_valor_unico_por_instalacao
CORS_ORIGIN=http://localhost:5173
ADMIN_SEED_PASSWORD=CHANGE_ME_REQUIRED_IN_PRODUCTION

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
