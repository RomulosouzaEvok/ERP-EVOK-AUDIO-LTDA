{
  "expo": {
    "name": "Evok Áudio Estoque",
    "slug": "evok-audio-mobile",
    "scheme": "evokaudio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.evokaudio.erp.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera é usada para ler o QR Code/código de barras dos produtos no inventário mobile."
      }
    },
    "android": {
      "package": "com.evokaudio.erp.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera é usada para ler o QR Code/código de barras dos produtos no inventário mobile."
        }
      ]
    ],
    "extra": {
      "router": {}
    }
  }
}
