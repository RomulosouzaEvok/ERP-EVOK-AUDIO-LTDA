# =============================================================================
# ERP EVOK AUDIO - Configuracao de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores.
#   cp .env.example .env
# =============================================================================

# --- Servidor ---
NODE_ENV=development
PORT=5000

# --- Banco de Dados PostgreSQL (Hostinger) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_evok_audio
DB_USER=evok_admin
DB_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
DB_SSL=false
DB_SSL_CA_PATH=
DB_SSL_CA_BASE64=
DB_LOGGING=false
DB_FORCE_SYNC=false
DB_AUTO_ALTER=false
DB_ALLOW_UNSAFE_ALTER=false

# --- JWT ---
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Admin Seed (usado apenas em primeira execucao) ---
# OBRIGATORIO em producao. O servidor falhara na inicializacao se nao definido.
ADMIN_SEED_PASSWORD=CHANGE_ME_REQUIRED_IN_PRODUCTION

# --- Upload ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# --- SMTP (recuperacao de senha - SEC-12) ---
# Sem estas variaveis, o link de recuperacao e apenas logado no servidor
# (nao enviado por e-mail). Necessario configurar em producao para o fluxo
# de "esqueci minha senha" funcionar de fato.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@evokaudio.com.br

# --- Alerta de falha de audit log (opcional) ---
# URL de webhook (Slack/Discord/Teams incoming webhook) notificada quando o
# audit log falha em gravar mesmo apos retry. Sem esta variavel, a falha e
# apenas persistida em logs/audit-failures.log, sem alerta ativo.
AUDIT_ALERT_WEBHOOK_URL=

# --- Webhook de entrada do n8n (obrigatorio para habilitar /api/webhooks/n8n) ---
# Segredo compartilhado usado para validar a assinatura HMAC-SHA256
# (header X-Evok-Signature) de eventos recebidos do n8n. Sem esta variavel,
# o endpoint responde 503 (falha fechada) em vez de aceitar qualquer
# assinatura.
N8N_WEBHOOK_SECRET=CHANGE_ME_generate_a_random_32_byte_secret

