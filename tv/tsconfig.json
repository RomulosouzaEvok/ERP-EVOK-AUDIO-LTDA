{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Mesma correcao aplicada em `mobile/tsconfig.json`: `expo/tsconfig.base`
    // ainda define `moduleResolution: "node"` (node10), descontinuado no
    // TypeScript 5.x e removido no 7.0. Metro resolve como bundler.
    "module": "esnext",
    "moduleResolution": "bundler"
  }
}
